{
  "name": "nightswatch",
  "version": "0.0.0-dev",
  "description": "Keep your Claude Code sessions moving overnight: auto-approve prompts and resume when the usage limit resets.",
  "keywords": [
    "claude-code",
    "claude",
    "automation",
    "cli",
    "iterm2",
    "usage-limit",
    "auto-resume"
  ],
  "license": "MIT",
  "private": true,
  "author": "Razvan Macovei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razvanmacovei/nightswatch.git"
  },
  "type": "module",
  "bin": {
    "nightswatch": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
